# ==============================================================================
# SIBAR - Environment Variables Template
# Copy this file to '.env.local' for local development or set in your production host.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URLs & Environment
# ------------------------------------------------------------------------------
# Local: http://localhost:3000
# Production: https://your-domain.com (No trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Authentication & Security Secrets
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens, JWTs, and HMAC verification.
# Generate a strong 32+ character random string in production (e.g. via `openssl rand -base64 32`).
SESSION_SECRET="your_random_secure_session_secret_32_characters_minimum"

# Initial/Default admin credentials for seeding / first-time setup
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me_to_a_secure_password"

# ------------------------------------------------------------------------------
# 3. Database
# ------------------------------------------------------------------------------
# Local SQLite database path (default: './sibar.db')
DATABASE_URL="./sibar.db"

# ------------------------------------------------------------------------------
# 4. Google AI / Gemini API
# ------------------------------------------------------------------------------
# Required for AI OCR scanner, problem adjusting, and math assist features.
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 5. Google Drive & OAuth 2.0 Integration
# ------------------------------------------------------------------------------
# Required for Google Drive cloud attachment storage.
# Configure at Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Ensure redirect URI includes: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID="your_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# ------------------------------------------------------------------------------
# 6. Optional Integrations
# ------------------------------------------------------------------------------
# API-Ninjas key for dynamic quotes (optional fallback used if empty)
# Obtain at: https://api-ninjas.com
NINJAS_API_KEY=""

