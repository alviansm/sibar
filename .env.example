# Sibar Security & Configuration Environment Variables

# JWT Session Secret Key (min 32 characters recommended)
SESSION_SECRET="replace_with_a_random_32_plus_char_secret_key"

# Google Gemini API Key for OCR & Telemetry Feedback
GEMINI_API_KEY="your_google_gemini_api_key_here"

# SQLite Database Location
DATABASE_URL="sibar.db"

# Admin Account Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
